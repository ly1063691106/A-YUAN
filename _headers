# Cloudflare Pages 缓存策略
# 说明：本文件只在 Cloudflare Pages 生效，GitHub Pages 会忽略它。
# 规则上限：100 条，单条 2000 字符。

# 图片素材：文件名由「相册+序号」生成，重建后同路径可能换内容，
# 因此不做一年期 immutable，改为 1 小时，避免新旧混搭。
/assets/media/*
  Cache-Control: public, max-age=3600

# 字体：同上
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 样式与脚本：文件名为固定值，改动需重新验证，给 1 小时
/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

# 作品数据：后台改精选后要尽快生效，给 5 分钟
/data/*
  Cache-Control: public, max-age=300

# 页面本身：短缓存，保证更新及时可见
/
  Cache-Control: public, max-age=600

/index.html
  Cache-Control: public, max-age=600

# 安全响应头
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
